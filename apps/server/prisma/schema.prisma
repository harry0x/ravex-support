generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  AGENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         Role       @default(CUSTOMER)
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(ACTIVE)
  lastSeenAt   DateTime?  @map("last_seen_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  customerConversations Conversation[] @relation("CustomerConversations")
  agentConversations    Conversation[] @relation("AgentConversations")
  messages              Message[]
  reads                 MessageRead[]
  reactions             Reaction[]
  uploads               Attachment[]

  @@index([role, status])
  @@map("users")
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  conversations Conversation[]

  @@map("departments")
}

model Conversation {
  id            String             @id @default(uuid()) @db.Uuid
  customerId    String             @map("customer_id") @db.Uuid
  agentId       String?            @map("agent_id") @db.Uuid
  departmentId  String?            @map("department_id") @db.Uuid
  subject       String
  status        ConversationStatus @default(OPEN)
  priority      Priority           @default(NORMAL)
  lastMessageAt DateTime?          @map("last_message_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  customer    User         @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Restrict)
  agent       User?        @relation("AgentConversations", fields: [agentId], references: [id], onDelete: SetNull)
  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  messages    Message[]
  attachments Attachment[]

  @@index([customerId, lastMessageAt])
  @@index([agentId, status])
  @@index([status, lastMessageAt])
  @@index([departmentId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  // Null for SYSTEM messages.
  senderId       String?     @map("sender_id") @db.Uuid
  content        String
  type           MessageType @default(TEXT)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  editedAt       DateTime?   @map("edited_at")
  deletedAt      DateTime?   @map("deleted_at")

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)
  attachments  Attachment[]
  reads        MessageRead[]
  reactions    Reaction[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

/// Cloudinary stores the file; this row stores its metadata. Uploads are created first
/// (messageId null) and linked when the message that uses them is sent.
model Attachment {
  id             String   @id @default(uuid()) @db.Uuid
  messageId      String?  @map("message_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  uploaderId     String?  @map("uploader_id") @db.Uuid
  publicId       String   @map("public_id")
  url            String
  secureUrl      String   @map("secure_url")
  resourceType   String   @map("resource_type")
  originalName   String   @map("original_name")
  mimeType       String   @map("mime_type")
  size           Int
  createdAt      DateTime @default(now()) @map("created_at")

  message      Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  uploader     User?        @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([conversationId, uploaderId])
  @@map("attachments")
}

model MessageRead {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_reads")
}

model Reaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([userId])
  @@map("reactions")
}
