NODE_ENV=development
PORT=3000

# Pooled connection (runtime). On Neon, this is the "-pooler" host.
DATABASE_URL=postgresql://user:password@host-pooler/db?sslmode=require
# Direct connection used by Prisma migrations. On Neon, the same URL without "-pooler".
DIRECT_URL=postgresql://user:password@host/db?sslmode=require
# Integration tests run in an isolated schema (wiped by the tests). Never point at real data.
TEST_DATABASE_URL=postgresql://user:password@host/db?sslmode=require&schema=test

JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

# Used by "pnpm db:seed" to create the first admin account
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_please

# Cloudinary (uploads are disabled until all three are set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_FILE_SIZE=10485760
